# Environment configuration for CreoTask
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# ─── Server ───────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────
DB_PATH=./server/data/creotask.db

# ─── Authentication ────────────────────────────────────
JWT_SECRET=CHANGE_ME_to_a_long_random_string_before_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ─── Social sign-in (optional) ─────────────────────────
# Each button works only when both its ID and secret are set; otherwise it shows
# as "Coming soon". Register this redirect URL with each provider:
#   <OAUTH_REDIRECT_BASE>/api/auth/oauth/<google|github|linkedin>/callback
# OAUTH_REDIRECT_BASE defaults to CLIENT_ORIGIN.
OAUTH_REDIRECT_BASE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ─── Email (Nodemailer / SMTP) ─────────────────────────
# For development, use a service like Mailtrap or Ethereal.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_ethereal_user
SMTP_PASS=your_ethereal_pass
EMAIL_FROM="CreoTask <noreply@creotask.in>"

# ─── File Uploads ──────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ─── Platform Settings ─────────────────────────────────
PLATFORM_FEE_PERCENT=10
OFFER_EXPIRY_HOURS=72

# ─── Payments (PRD §13 critical launch gate) ───────────
# disabled (default) — funding/payout endpoints refuse with PAYMENTS_DISABLED.
# sandbox            — dev/test only: records labelled TEST ledger entries. No real money.
#                      Ignored (forced to disabled) when NODE_ENV=production.
# There is no live mode until a provider, fund flow, legal and tax review are approved.
PAYMENTS_MODE=disabled

# Provider keys are NOT used yet. Do not add live keys.
PAYMENT_GATEWAY=none
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Policy (PROPOSED values — founder decisions pending) ─
MIN_ACCOUNT_AGE=18
AGE_POLICY_VERSION=2026-11-draft
AVAILABILITY_STALE_DAYS=30
SESSION_TTL_DAYS=7
# Shown to suspended users as the appeal route
APPEALS_CONTACT=

# ─── Frontend Origin ───────────────────────────────────
CLIENT_ORIGIN=http://localhost:3000
